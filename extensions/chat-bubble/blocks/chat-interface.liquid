{{ 'chat.css' | asset_url | stylesheet_tag }}
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<div
  class="shop-ai-chat-container{% if block.settings.chat_position == 'right' %} shop-ai-position-right{% endif %}"
  style="--shop-ai-primary: {{ block.settings.chat_bubble_color }}; --shop-ai-primary-dark: {{ block.settings.chat_bubble_color | color_darken: 12 }};"
>
  <div class="shop-ai-chat-bubble">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </div>

  <div class="shop-ai-chat-window">
    <div class="shop-ai-chat-header">
      <div>{% if block.settings.chat_title != blank %}{{ block.settings.chat_title }}{% else %}{{ 'chat.title' | t }}{% endif %}</div>
      <button class="shop-ai-chat-close">✕</button>
    </div>

    <div class="shop-ai-chat-messages">
      <!-- Messages will be added here by JavaScript -->
    </div>

    <div class="shop-ai-chat-input">
      <input type="text" placeholder="{{ 'chat.inputPlaceholder' | t }}">
      <button class="shop-ai-chat-send">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script>
  window.shopChatConfig = {
    promptType: {{ block.settings.system_prompt | json }},
    welcomeMessage: {{ block.settings.welcome_message | json }},
    apiBaseUrl: "https://shop-chat-agent-henna.vercel.app"
  };
  window.shopId = {{ shop.id }};
</script>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "chat_bubble_color",
      "label": "Chat color",
      "info": "Used everywhere: the floating bubble, chat header, your customers' message bubbles, links, and buttons.",
      "default": "#5046e4"
    },
    {
      "type": "select",
      "id": "chat_position",
      "label": "Position on page",
      "options": [
        { "value": "left", "label": "Bottom left" },
        { "value": "right", "label": "Bottom right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "chat_title",
      "label": "Chat window title",
      "info": "Leave blank to use the default."
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "👋 Hi! Ask me anything about NextLED products or store policies."
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "System Prompt",
      "options": [
        {
          "value": "standardAssistant",
          "label": "Standard Assistant"
        },
        {
          "value": "enthusiasticAssistant",
          "label": "Enthusiastic Assistant"
        }
      ],
      "default": "standardAssistant"
    }
  ]
}
{% endschema %}
